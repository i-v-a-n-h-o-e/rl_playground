# Compose and image identity. Change these after forking the template.
COMPOSE_PROJECT_NAME=pet-project
IMAGE_NAME=pet-project-dev
IMAGE_TAG=local
CONTAINER_NAME=pet-project-dev
CONTAINER_HOSTNAME=pet-project-dev
SOURCE_URL=

# Use 0.0.0.0 only on a trusted LAN/VPN. Use 127.0.0.1 for local-only access.
BIND_ADDRESS=0.0.0.0
SSH_PORT=2222
JUPYTER_PORT=8888

# ./c init replaces this value with a random secret.
JUPYTER_TOKEN=change-me

# On Linux, ./c init uses the host UID/GID. On macOS it keeps container defaults.
CONTAINER_UID=1000
CONTAINER_GID=1000

# Shared memory for PyTorch DataLoader workers and vectorized environments.
SHM_SIZE=2gb

# Empty disables the supervised application. This example emits heartbeats.
APP_COMMAND=python examples/worker.py

TZ=UTC
